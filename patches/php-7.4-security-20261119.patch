diff --git a/main/fastcgi.c b/main/fastcgi.c
index 03c4aaf..23235bf 100644
--- a/main/fastcgi.c
+++ b/main/fastcgi.c
@@ -1049,6 +1049,10 @@ static int fcgi_read_request(fcgi_request *req)
 	int len, padding;
 	unsigned char buf[FCGI_MAX_LENGTH+8];
 
+	if (UNEXPECTED(req->in_len != 0)) {
+		return 0;
+	}
+
 	req->keep = 0;
 	req->ended = 0;
 	req->in_len = 0;
@@ -1312,6 +1316,8 @@ void fcgi_close(fcgi_request *req, int force, int destroy)
 		req->nodelay = 0;
 #endif
 		req->fd = -1;
+		/* a partially read STDIN record does not outlive its connection */
+		req->in_len = 0;
 
 		req->hook.on_close();
 	}
# ---- sury 0208-Fix-GHSA-4646-p932-gw34-keep-SOAP-DTD-alive-during-c.patch
diff --git a/ext/soap/php_xml.c b/ext/soap/php_xml.c
index d2a03c6..26ba9a3 100644
--- a/ext/soap/php_xml.c
+++ b/ext/soap/php_xml.c
@@ -52,6 +52,9 @@ static void cleanup_xml_node(xmlNodePtr node)
 				xmlUnlinkNode(trav);
 				xmlFreeNode(trav);
 			}
+		} else if (trav->type == XML_DTD_NODE) {
+			/* Attribute-value entity references can share content with the DTD.
+			 * Keep it alive until the document itself is freed. */
 		} else if ((trav->type != XML_ELEMENT_NODE) &&
 		           (trav->type != XML_CDATA_SECTION_NODE)) {
 			xmlUnlinkNode(trav);
